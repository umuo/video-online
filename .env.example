# 本地默认连接 http://localhost:8787，可不填写。
# play.lacknb.com 默认通过同域名 /api 路由访问 Worker；其他部署可覆盖此地址。
VITE_REALTIME_URL=https://play.lacknb.com

# Worker 允许的网页来源，多个来源用英文逗号分隔，也支持单段子域名通配符。
ALLOWED_ORIGIN=https://play.lacknb.com,https://tongying-room.pages.dev,https://*.tongying-room.pages.dev

# 最后一人离开后自动解散房间的等待时间，生产环境为 1 小时。
ROOM_EMPTY_TTL_MS=3600000
